{
  "name": "queryio",
  "version": "0.1.0",
  "description": "Bounded, read-oriented PostgreSQL investigation interface for coding agents (MCP stdio server).",
  "author": "Aradhya Singh",
  "license": "MIT",
  "homepage": "https://github.com/aradhyas8/queryio-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aradhyas8/queryio-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/aradhyas8/queryio-mcp/issues"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "mcp",
    "model-context-protocol",
    "agent",
    "database",
    "sql"
  ],
  "type": "module",
  "bin": {
    "queryio": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "benchmark:mcp:setup": "node benchmark/mcp-v2/harness/setup.mjs",
    "benchmark:mcp:validate": "node benchmark/mcp-v2/harness/validate.mjs",
    "benchmark:mcp:probe": "node benchmark/mcp-v2/harness/probe.mjs",
    "benchmark:mcp:smoke": "node benchmark/mcp-v2/harness/pipeline.mjs --profile smoke",
    "benchmark:mcp:run": "node benchmark/mcp-v2/harness/pipeline.mjs --profile full",
    "benchmark:mcp": "node benchmark/mcp-v2/harness/pipeline.mjs --profile full",
    "benchmark:mcp:codex:smoke": "node benchmark/mcp-v2/harness/pipeline.mjs --profile codex-smoke",
    "benchmark:mcp:codex": "node benchmark/mcp-v2/harness/pipeline.mjs --profile full",
    "benchmark:mcp:grade": "node benchmark/mcp-v2/harness/grader.mjs",
    "benchmark:mcp:report": "node benchmark/mcp-v2/harness/report.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "pg": "8.23.1",
    "pg-cursor": "2.22.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
